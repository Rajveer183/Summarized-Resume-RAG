# ============================================================
# Cloud Run image for the frontend, serving the Vite production build
# via nginx. Alternative to Firebase Hosting — use this if you want the
# frontend containerized alongside the backend on Cloud Run.
#
# VITE_API_URL must be passed as a build arg pointing at the deployed
# backend's Cloud Run URL (frontend/src/api/resumeApi.js reads it via
# import.meta.env.VITE_API_URL at build time — this is baked into the
# static JS bundle, not read at container runtime).
#
# Build:
#   gcloud builds submit --tag REGION-docker.pkg.dev/PROJECT_ID/resume-rag/frontend:TAG \
#     --file frontend/Dockerfile.gcp \
#     --build-arg VITE_API_URL=https://resume-rag-backend-xxxxx.a.run.app \
#     frontend/
#
# Local equivalent:
#   docker build -f frontend/Dockerfile.gcp \
#     --build-arg VITE_API_URL=http://localhost:8000 \
#     -t resume-rag-frontend:local frontend/
#   docker run --rm -p 8080:8080 resume-rag-frontend:local
# ============================================================
FROM node:20-slim AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.gcp.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O- http://localhost:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
